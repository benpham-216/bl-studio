{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bl.studio/contracts/project.schema.json",
  "title": "Studio Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "extends", "releaseVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "extends": { "type": "string", "pattern": "^templates/[a-z][a-z0-9-]*$" },
    "releaseVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" }
  }
}
