{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bl.studio/contracts/form.schema.json",
  "title": "Studio Form Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "form" },
    "name": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "instanceName"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "instanceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
