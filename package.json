{
  "name": "bl-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "pnpm generate && pnpm --filter @bl-studio/studio-web dev",
    "generate": "tsx scripts/generate-studio-data.ts",
    "validate": "tsx scripts/generate-studio-data.ts --validate-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm generate && pnpm --filter @bl-studio/studio-web build",
    "check": "pnpm validate && pnpm test && pnpm generate && pnpm typecheck && pnpm --filter @bl-studio/studio-web build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
